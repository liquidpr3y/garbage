# Copy to .env (gitignored). Placeholders only -- never commit real lab values.
# See docs/SAFETY.md.

NECROPSY_OPERATOR=your.name
NECROPSY_DB_URL=sqlite:///./necropsy.db
NECROPSY_VAULT_ROOT=~/.necropsy/vault

# 32 bytes, base64. Generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Leave unset in dev and a key is generated at NECROPSY_VAULT_ROOT/../vault.key (mode 0400).
# NECROPSY_VAULT_KEY=

NECROPSY_REDIS_URL=redis://localhost:6379/1
NECROPSY_HTTP_PORT=8010

# Detonation targets available to this install. POC is ARM-only (docs/ARCHITECTURE.md S5),
# which is what drives the arch_mismatch_risk finding on x86 samples.
NECROPSY_TARGET_ARCHES=arm64

# Phase 4. Left blank in Phase 1; the finding sink is a no-op until it is set.
# NECROPSY_ELASTIC_URL=
# NECROPSY_ELASTIC_API_KEY=

# --- Phase 3: dynamic analysis -------------------------------------------
# Off by default. Detonation runs live malware, so it takes an explicit opt-in.
NECROPSY_SANDBOX_ENABLED=false
NECROPSY_SANDBOX_TARGET=vmware
# NECROPSY_VMRUN_PATH=/Applications/VMware Fusion.app/Contents/Public/vmrun
# NECROPSY_SANDBOX_VMX_PATH=~/Virtual Machines.localized/win11-arm.vmwarevm/win11-arm.vmx
# NECROPSY_SANDBOX_SNAPSHOT_ISOLATED=clean-isolated
# Egress runs need their own snapshot on a network that actually has egress.
# Without it an egress request is refused, never silently downgraded.
# NECROPSY_SANDBOX_SNAPSHOT_EGRESS=
# NECROPSY_SANDBOX_GUEST_USER=analyst
# NECROPSY_SANDBOX_GUEST_PASSWORD=          # secret: keep it out of git
# NECROPSY_SANDBOX_GUEST_HOSTNAME=WIN-LAB-01   # must match host.name in Elastic
NECROPSY_SANDBOX_GUEST_ARCH=arm64
NECROPSY_SANDBOX_RUN_SECONDS=120
# A host-only vmnet, never the uplink.
# NECROPSY_SANDBOX_PCAP_INTERFACE=vmnet1

# The lab's existing cluster. Phase 3 reads Sysmon back out of it.
# NECROPSY_ELASTIC_URL=https://elastic.lab.internal:9200
# NECROPSY_ELASTIC_API_KEY=
NECROPSY_ELASTIC_SYSMON_INDEX=logs-windows.sysmon_operational-*
